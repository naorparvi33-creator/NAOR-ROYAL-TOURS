func t(key: String) -> String:
	var table: Dictionary = STRINGS.get(lang, STRINGS["he"])
	return table.get(key, key)


func is_rtl() -> bool:
	return lang == "he"


func set_language(new_lang: String) -> void:
	if new_lang == lang or not STRINGS.has(new_lang):
		return
	lang = new_lang
	language_changed.emit()
