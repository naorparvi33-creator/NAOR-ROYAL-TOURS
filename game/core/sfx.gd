extends Node
## Sound effects and music. All sounds are generated by tools/audiogen/make_sounds.py.
##  * play_3d(): pooled positional sounds (gunshots, hits, doors)
##  * play_ui(): flat sounds (mission jingles, money)
##  * music: calm city track on foot, car radio stations while driving (cross-faded)

signal station_changed(name_key: String)

const SOUNDS := ["gun_rifle", "gun_pistol", "punch", "hit_flesh", "bullet_impact", "car_door",
	"car_crash", "mission_start", "mission_done", "mission_fail", "money"]
const STATIONS := [
	{"key": "radio_synth", "name": "radio_1"},
	{"key": "radio_beats", "name": "radio_2"},
	{"key": "", "name": "radio_off"},
]
const POOL := 14

var _streams := {}
var _pool: Array[AudioStreamPlayer3D] = []
var _pool_i := 0
var _ui: AudioStreamPlayer
var _music: AudioStreamPlayer
var _radio: AudioStreamPlayer
var _in_car := false
var station := 0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for s in SOUNDS:
		_streams[s] = load("res://assets/audio/%s.wav" % s)
	for i in POOL:
		var p := AudioStreamPlayer3D.new()
		p.unit_size = 6.0
		p.max_distance = 160.0
		p.attenuation_filter_cutoff_hz = 6000.0
		add_child(p)
		_pool.append(p)
	_ui = AudioStreamPlayer.new()
	add_child(_ui)
	_music = AudioStreamPlayer.new()
	_music.stream = load("res://assets/audio/music_city.wav")
	add_child(_music)
	_radio = AudioStreamPlayer.new()
	add_child(_radio)
	Settings.changed.connect(func(k):
		if k in ["music_volume", "sfx_volume"]:
			_apply_volumes())
	_apply_volumes()
	_music.play()


func _apply_volumes() -> void:
	var mv := float(Settings.get_value("music_volume"))
	var sv := float(Settings.get_value("sfx_volume"))
	_music.volume_db = linear_to_db(maxf(mv * 0.55, 0.0001)) if not _in_car else -80.0
	_radio.volume_db = linear_to_db(maxf(mv * 0.8, 0.0001)) if _in_car else -80.0
	for p in _pool:
		p.volume_db = linear_to_db(maxf(sv, 0.0001))
	_ui.volume_db = linear_to_db(maxf(sv * 0.8, 0.0001))


func play_3d(sound: String, pos: Vector3, volume_db := 0.0, pitch := 1.0) -> void:
	if not _streams.has(sound):
		return
	var p := _pool[_pool_i]
	_pool_i = (_pool_i + 1) % POOL
	p.stream = _streams[sound]
	p.global_position = pos
	p.volume_db = linear_to_db(maxf(float(Settings.get_value("sfx_volume")), 0.0001)) + volume_db
	p.pitch_scale = pitch * randf_range(0.94, 1.06)
	p.play()


func play_ui(sound: String) -> void:
	if _streams.has(sound):
		_ui.stream = _streams[sound]
		_ui.play()


## Called when the player gets in or out of a car: street music <-> radio.
func set_in_car(on: bool) -> void:
	_in_car = on
	if on:
		_start_station()
	else:
		_radio.stop()
		if not _music.playing:
			_music.play()
	_apply_volumes()


func next_station() -> void:
	station = (station + 1) % STATIONS.size()
	_start_station()


func _start_station() -> void:
	var st: Dictionary = STATIONS[station]
	_radio.stop()
	if st["key"] != "":
		_radio.stream = load("res://assets/audio/%s.wav" % st["key"])
		_radio.play(randf() * 20.0)   # tune in mid-song, like a real radio
	station_changed.emit(st["name"])
	_apply_volumes()
