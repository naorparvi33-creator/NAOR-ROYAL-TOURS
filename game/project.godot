; Engine configuration file.
config_version=5

[application]

config/name="Open World Sniper"
config/description="Open world mobile shooter - stage 1 skeleton"
config/version="0.1.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
run/low_processor_mode=false

[autoload]

Loc="*res://core/loc.gd"
Settings="*res://core/settings.gd"
GameInput="*res://core/game_input.gd"
Perf="*res://core/perf.gd"
Sfx="*res://core/sfx.gd"
Fx="*res://core/fx.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true
sensors/enable_gyroscope=true
sensors/enable_accelerometer=false
sensors/enable_gravity=false
sensors/enable_magnetometer=false

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
common/physics_interpolation=true
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=false
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/positional_shadow/atlas_size=0
lights_and_shadows/positional_shadow/atlas_size.mobile=0
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
scaling_3d/mode=0
scaling_3d/scale=1.0
occlusion_culling/use_occlusion_culling=true
environment/defaults/default_clear_color=Color(0.55, 0.7, 0.85, 1)
